# ReClaw .gitignore - ignore runtime, memory, sensitive, builds
memory/.dreams/
.openclaw/
*.log
/tmp/
__pycache__/
*.pyc
node_modules/
dist/
.env
*.pid
# dashboard source is tracked; only ignore build artifacts
dashboard/**/node_modules/
dashboard/**/.next/
dashboard/**/dist/
dashboard/**/.turbo/
.DS_Store
.idea/
.vscode/
*.bak
*.backup
*.eradicating*
secrets/
credentials/
.credentials.json
**/google_token.json
**/token.json
# Ignore generated memory and session logs that may contain tokens
memory/dreaming/
memory/*.md  # keep only curated; runtime in rooms/
.venv/
# Runtime data (rebuilt on server; do not commit)
data/cache/
data/inbox/*
!data/inbox/.gitkeep
data/county_queue/state.json
data/county_queue/pending/
data/rag_chroma/
data/rag_embeddings/
data/rag_state/
data/runs/
data/sessions/
data/mcp_logs/
data/mcp_queue.jsonl
data/mcp_public_url.txt
data/mcp_tunnel_host.txt
outputs/
