{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session_digest.py\" 2>/dev/null || true",
            "timeout": 60,
            "async": true,
            "statusMessage": "Writing session digest to the vault"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
