# ReClaw 2.0 .env (copy to .env and edit)
RECLAW_ENV=dev
LOG_LEVEL=INFO

# Obsidian vault — source of truth (must use RECLAW_ prefix)
# Hetzner production:
RECLAW_OBSIDIAN_VAULT_PATH=/root/obsidian_vault
RECLAW_OBSIDIAN_SUBDIR=Rural Data
# Windows dev mirror:
# RECLAW_OBSIDIAN_VAULT_PATH=C:/Users/Jason/Documents/obsidian_vault

# Data behavior
USE_LIVE_FETCH=false
FETCH_TIMEOUT=15
MAX_PROPERTIES_PER_COUNTY=80

# Future LLM
ENABLE_LLM_ANALYSIS=false
LLM_MODEL=llama3.1:8b

# Safety
WRITE_DRY_RUN=false
JOB_TIMEOUT_SECONDS=300

# Public data API keys (optional)
CENSUS_API_KEY=your-census-key  # free at api.census.gov/data/key_signup.html
FIRECRAWL_API_KEY=fc-your-key  # https://firecrawl.dev — Tier-3 discovery (county sites, SBOA, DOR)
OBSIDIAN_API_KEY=your-local-rest-api-key  # only if Obsidian desktop + Local REST API plugin on same machine

# LLM API keys (optional)
XAI_API_KEY=your-xai-key
GEMINI_API_KEY=your-gemini-key
GOOGLE_API_KEY=your-gemini-key

# Gateway auth (use the same value for both)
OPENCLAW_GATEWAY_TOKEN=your-token-here
RECLAW_GATEWAY_TOKEN=your-token-here

# RAG (optional — defaults work on CPU)
RAG_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_PERSIST_DIR=data/rag_chroma
RAG_VAULT_SYNC_INTERVAL=300
